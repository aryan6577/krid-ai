# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=replace_with_your_groq_api_key

# Any current Groq chat model with tool-calling support works.
# llama-3.1-8b-instant has by far the highest free-tier limits of any Groq model
# (30 req/min, 14,400 req/day, 500,000 tokens/day as of Aug 2026) — effectively
# unlimited for a demo chatbot — so it's the default here.
# (llama-3.3-70b-versatile was deprecated by Groq in June 2026 — see
# https://console.groq.com/docs/deprecations. openai/gpt-oss-120b is a heavier,
# smarter fallback with a much lower daily cap if you want more reasoning power.)
GROQ_MODEL=llama-3.1-8b-instant

PORT=5001

# Supabase Auth + Postgres REST API for real login/onboarding/profile CRUD.
SUPABASE_URL=replace_with_your_supabase_url
SUPABASE_ANON_KEY=replace_with_your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_supabase_service_role_key

# Required only for the manual admin verification-status stub endpoint.
ADMIN_API_SECRET=replace_with_a_local_admin_secret

# Razorpay test/sandbox mode. Use test keys from the Razorpay dashboard.
RAZORPAY_KEY_ID=replace_with_your_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_key_secret
RAZORPAY_API_URL=https://api.razorpay.com/v1

# Private Python pose service used by the camera training flow.
CV_SERVICE_URL=http://127.0.0.1:8001
KRID_CV_API_KEY=replace_with_shared_cv_service_key
